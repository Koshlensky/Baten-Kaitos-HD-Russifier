{"key": "bk2:WORLDMAP_01", "game": "bk2", "source_file": "a8cc32bba98258300a54327273719c75.bundle#TextData_en", "text_id": "WORLDMAP_01", "id_index": 14922, "category": "dialogue", "form": "line", "flags": [], "scene_id": "bk2:WORLDMAP#00", "batch_id": "bk2:B0290", "order": 0, "global_order": 14922, "prev_key": null, "next_key": "bk2:WORLDMAP_02", "en_sha1": "da61279894c9e2f5866ef634d7ed1a4cd56c59a6", "dedup_group": "bk2:en#14451", "dedup_size": 1, "tags": ["<w>", "<p>", "<w>", "<p>", "<w>"], "variant": null, "speaker": {"id": "unknown", "status": "unknown", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": [], "script": {"status": "no_tag", "names": [], "no_tag_calls": 1, "dynamic_calls": 0}}, "speaker_gender": "unknown", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "Окно без таблички имени (описание, мысль или безымянный говорящий).", "ru": "Вы вошли в ловушку!<w><p>Её в основном используют в начале событий, которые начинаются с реплики.<w><p>Обычно она ставит флаг, чтобы её не вызвали второй раз.<w>", "status": "edited", "qa_flags": [], "translator_note": "отладочный текст", "editor_note": "", "history": [{"ts": "2026-10-20T01:30:34", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261020/bk2_B0290_translator_013034.json"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T02:21:31", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261020/bk2_B0290_editor_022131.json"}]}
{"key": "bk2:WORLDMAP_02", "game": "bk2", "source_file": "a8cc32bba98258300a54327273719c75.bundle#TextData_en", "text_id": "WORLDMAP_02", "id_index": 14923, "category": "dialogue", "form": "line", "flags": [], "scene_id": "bk2:WORLDMAP#00", "batch_id": "bk2:B0290", "order": 1, "global_order": 14923, "prev_key": "bk2:WORLDMAP_01", "next_key": "bk2:WORLDMAP_03", "en_sha1": "8c555571998247607c5683dd498a6b2f7008060f", "dedup_group": "bk2:en#14452", "dedup_size": 1, "tags": ["<w>", "<p>", "<w>", "<p>", "<w>"], "variant": null, "speaker": {"id": "unknown", "status": "unknown", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": [], "script": {"status": "not_found", "names": [], "no_tag_calls": 0, "dynamic_calls": 0}}, "speaker_gender": "unknown", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "Вы вышли из ловушки!<w><p>Эта функция почти не применяется — разве что возвращает всё в норму после действий в ON_TRAP_IN.<w><p>Обычно она ставит флаг, чтобы её не вызвали второй раз.<w>", "status": "edited", "qa_flags": [], "translator_note": "отладочный текст", "editor_note": "", "history": [{"ts": "2026-10-20T01:30:34", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261020/bk2_B0290_translator_013034.json"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T02:21:31", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261020/bk2_B0290_editor_022131.json"}]}
{"key": "bk2:WORLDMAP_03", "game": "bk2", "source_file": "a8cc32bba98258300a54327273719c75.bundle#TextData_en", "text_id": "WORLDMAP_03", "id_index": 14924, "category": "dialogue", "form": "line", "flags": [], "scene_id": "bk2:WORLDMAP#00", "batch_id": "bk2:B0290", "order": 2, "global_order": 14924, "prev_key": "bk2:WORLDMAP_02", "next_key": "bk2:WORLDMAP_04", "en_sha1": "0d16669ae379dd84d01fe28d1bc350e0d51af5ab", "dedup_group": "bk2:en#14453", "dedup_size": 1, "tags": ["<w>", "<p>", "<w>"], "variant": null, "speaker": {"id": "NPCName_110", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": ["polite"], "script": {"status": "name_tag", "names": [{"id": "NPCName_110", "en": "Sfida Attendant", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "NPCName_110", "en": "Sfida Attendant"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "unknown", "addressee": {"id": "unknown", "status": "unknown", "candidates": ["Sagi"]}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "Саги, до меня дошло, что ты наконец стал чемпионом!<w><p>Потрясающе! Поздравляю, господин! Теперь девушки будут вешаться на меня — я же твой личный шофёр!<w>", "status": "edited", "qa_flags": [], "translator_note": "обращение ты — по тону и имени без титула", "editor_note": "РОД-подсказка неверна: адресат Саги — мужчина по карточке", "history": [{"ts": "2026-10-20T01:30:34", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261020/bk2_B0290_translator_013034.json"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T02:21:31", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261020/bk2_B0290_editor_022131.json"}]}
{"key": "bk2:WORLDMAP_04", "game": "bk2", "source_file": "a8cc32bba98258300a54327273719c75.bundle#TextData_en", "text_id": "WORLDMAP_04", "id_index": 14925, "category": "dialogue", "form": "line", "flags": [], "scene_id": "bk2:WORLDMAP#00", "batch_id": "bk2:B0290", "order": 3, "global_order": 14925, "prev_key": "bk2:WORLDMAP_03", "next_key": "bk2:WORLDMAP_05", "en_sha1": "ccd047c508973157fdcbdd91c1825b16ab36f390", "dedup_group": "bk2:en#14454", "dedup_size": 1, "tags": ["<w>", "<p>", "<w>"], "variant": null, "speaker": {"id": "NPCName_110", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": [], "script": {"status": "name_tag", "names": [{"id": "NPCName_110", "en": "Sfida Attendant", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "NPCName_110", "en": "Sfida Attendant"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "unknown", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "Недавно приходила девушка, сказала, что она твоя поклонница, — хотела взглянуть на корабль!<w><p>Саги, да ты, оказывается, сердцеед!<w>", "status": "edited", "qa_flags": [], "translator_note": "", "editor_note": "", "history": [{"ts": "2026-10-20T01:30:34", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261020/bk2_B0290_translator_013034.json"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T02:21:31", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261020/bk2_B0290_editor_022131.json", "ru_before": "Недавно приходила девушка, сказала, что она твоя поклонница, — хотела взглянуть на корабль!<w><p>Саги, не знал, что ты такой сердцеед!<w>"}, {"ts": "2026-10-20T05:21:39", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261020/bk2_B0290_editor_052139.json"}]}
{"key": "bk2:WORLDMAP_05", "game": "bk2", "source_file": "a8cc32bba98258300a54327273719c75.bundle#TextData_en", "text_id": "WORLDMAP_05", "id_index": 14926, "category": "dialogue", "form": "line", "flags": [], "scene_id": "bk2:WORLDMAP#00", "batch_id": "bk2:B0290", "order": 4, "global_order": 14926, "prev_key": "bk2:WORLDMAP_04", "next_key": "bk2:WORLDMAP_06", "en_sha1": "4c9d360b280b7c11bac1f1378d0edfcd7ca3270e", "dedup_group": "bk2:en#14455", "dedup_size": 1, "tags": ["<w>", "<p>", "<w>"], "variant": null, "speaker": {"id": "NPCName_110", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": [], "script": {"status": "name_tag", "names": [{"id": "NPCName_110", "en": "Sfida Attendant", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "NPCName_110", "en": "Sfida Attendant"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "unknown", "addressee": {"id": "unknown", "status": "unknown", "candidates": ["Sagi"]}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "Говорят, у успешных бойцов Колизея отбоя нет от поклонниц!<w><p>Саги, повышай ранг и познакомь меня с симпатичными девушками!<w>", "status": "edited", "qa_flags": [], "translator_note": "", "editor_note": "", "history": [{"ts": "2026-10-20T01:30:34", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261020/bk2_B0290_translator_013034.json"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T01:30:39", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-20T02:21:31", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261020/bk2_B0290_editor_022131.json"}]}
