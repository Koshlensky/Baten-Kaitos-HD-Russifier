{"key": "bk1:SCR_MAP02_6_1794", "game": "bk1", "source_file": "6a872618f189b35a4039d59de4a885c3.bundle#TextData_en", "text_id": "SCR_MAP02_6_1794", "id_index": 1246, "category": "dialogue", "form": "line", "flags": ["voiced"], "scene_id": "bk1:SCR_MAP02_6", "batch_id": "bk1:B0017", "order": 0, "global_order": 564, "prev_key": null, "next_key": "bk1:SCR_MAP02_6_1893", "en_sha1": "16846d03aad277cbeec2beb203d11738ebed3f5b", "dedup_group": "bk1:en#1190", "dedup_size": 1, "tags": ["<v>", "<w>", "<p>", "<v>", "<w>"], "variant": null, "speaker": {"id": "kalas", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": [], "script": {"status": "name_tag", "names": [{"id": "PCN_1", "en": "Kalas", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "PCN_1", "en": "Kalas"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "m", "addressee": {"id": "unknown", "status": "unknown", "candidates": ["Xelha"]}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "<v>Шелла, я тут вспомнил про твой кулон...<w><p><v>Его же забрали, когда тебя схватили?<w>", "status": "edited", "qa_flags": [], "translator_note": "", "editor_note": "", "history": [{"ts": "2026-10-19T15:14:00", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261019/bk1_B0017_translator_151400.json"}, {"ts": "2026-10-19T15:14:03", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-19T15:48:10", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261019/bk1_B0017_editor_154810.json"}]}
{"key": "bk1:SCR_MAP02_6_1893", "game": "bk1", "source_file": "6a872618f189b35a4039d59de4a885c3.bundle#TextData_en", "text_id": "SCR_MAP02_6_1893", "id_index": 1247, "category": "dialogue", "form": "line", "flags": ["voiced"], "scene_id": "bk1:SCR_MAP02_6", "batch_id": "bk1:B0017", "order": 1, "global_order": 565, "prev_key": "bk1:SCR_MAP02_6_1794", "next_key": "bk1:SCR_MAP02_6_1955", "en_sha1": "1d2b8514771246f9b547a27c6c81adff5e7f2240", "dedup_group": "bk1:en#1191", "dedup_size": 1, "tags": ["<v>", "<w>", "<p>", "<v>", "<w>", "<p>", "<v>", "<w>"], "variant": null, "speaker": {"id": "xelha", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "f", "m": 0, "f": 0.6}, "style": [], "script": {"status": "name_tag", "names": [{"id": "PCN_2", "en": "Xelha", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "PCN_2", "en": "Xelha"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "f", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "<v>Ну, Джакомо думал, что отобрал его у меня в особняке лорда Родольфо...\nно я была на шаг впереди. Тот, что у него, — подделка.<w><p><v>Я сделала копию на всякий случай, как только покинула столицу Империи.<w><p><v>Мало ли что, верно?<w>", "status": "edited", "qa_flags": [], "translator_note": "new_term: Imperial City → столица Империи", "editor_note": "", "history": [{"ts": "2026-10-19T15:14:00", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261019/bk1_B0017_translator_151400.json"}, {"ts": "2026-10-19T15:14:03", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-19T15:48:10", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261019/bk1_B0017_editor_154810.json"}]}
{"key": "bk1:SCR_MAP02_6_1955", "game": "bk1", "source_file": "6a872618f189b35a4039d59de4a885c3.bundle#TextData_en", "text_id": "SCR_MAP02_6_1955", "id_index": 1248, "category": "dialogue", "form": "line", "flags": ["voiced"], "scene_id": "bk1:SCR_MAP02_6", "batch_id": "bk1:B0017", "order": 2, "global_order": 566, "prev_key": "bk1:SCR_MAP02_6_1893", "next_key": "bk1:SCR_MAP02_6_2112", "en_sha1": "b861eb61be57aa81cba0427663e5e33898821167", "dedup_group": "bk1:en#1192", "dedup_size": 1, "tags": ["<v>", "<w>"], "variant": null, "speaker": {"id": "kalas", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "none", "m": 0.0, "f": 0.0}, "style": [], "script": {"status": "name_tag", "names": [{"id": "PCN_1", "en": "Kalas", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "PCN_1", "en": "Kalas"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "m", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "<v>Отлично, Шелла! Только не верится, что они ничего не заметили. Джакомо не такой дурак, каким выглядит, знаешь ли.<w>", "status": "edited", "qa_flags": [], "translator_note": "", "editor_note": "", "history": [{"ts": "2026-10-19T15:14:00", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261019/bk1_B0017_translator_151400.json"}, {"ts": "2026-10-19T15:14:03", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-19T15:48:10", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261019/bk1_B0017_editor_154810.json"}]}
{"key": "bk1:SCR_MAP02_6_2112", "game": "bk1", "source_file": "6a872618f189b35a4039d59de4a885c3.bundle#TextData_en", "text_id": "SCR_MAP02_6_2112", "id_index": 1249, "category": "dialogue", "form": "line", "flags": ["voiced"], "scene_id": "bk1:SCR_MAP02_6", "batch_id": "bk1:B0017", "order": 3, "global_order": 567, "prev_key": "bk1:SCR_MAP02_6_1955", "next_key": "bk1:SCR_MAP02_6_2293", "en_sha1": "59f5d0cc7b6fbd75f93884afec83258ee7fb2679", "dedup_group": "bk1:en#1193", "dedup_size": 1, "tags": ["<v>", "<w>", "<p>", "<v>", "<w>", "<p>", "<v>", "<w>"], "variant": null, "speaker": {"id": "xelha", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "f", "m": 0, "f": 0.7}, "style": [], "script": {"status": "name_tag", "names": [{"id": "PCN_2", "en": "Xelha", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "PCN_2", "en": "Xelha"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "f", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "<v>Я попросила одну старую ведьму наложить на него сложное иллюзорное заклинание.<w><p><v>Отличить их друг от друга нельзя. Во всяком случае, не так-то просто.<w><p><v>Готова поспорить, Гельдоблейм и Джакомо сейчас в ярости.<w>", "status": "edited", "qa_flags": [], "translator_note": "", "editor_note": "amplification: «не сразу» → «не так-то просто» (not that easily)", "history": [{"ts": "2026-10-19T15:14:00", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261019/bk1_B0017_translator_151400.json"}, {"ts": "2026-10-19T15:14:03", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-19T15:48:10", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261019/bk1_B0017_editor_154810.json", "ru_before": "<v>Я попросила одну старую ведьму наложить на него сложное иллюзорное заклинание.<w><p><v>Отличить их друг от друга нельзя. Во всяком случае, не сразу.<w><p><v>Готова поспорить, Гельдоблейм и Джакомо сейчас в ярости.<w>"}]}
{"key": "bk1:SCR_MAP02_6_2293", "game": "bk1", "source_file": "6a872618f189b35a4039d59de4a885c3.bundle#TextData_en", "text_id": "SCR_MAP02_6_2293", "id_index": 1250, "category": "dialogue", "form": "line", "flags": ["voiced"], "scene_id": "bk1:SCR_MAP02_6", "batch_id": "bk1:B0017", "order": 4, "global_order": 568, "prev_key": "bk1:SCR_MAP02_6_2112", "next_key": null, "en_sha1": "115b885ee32e230755720b59a1cc245cc4dd1a62", "dedup_group": "bk1:en#1194", "dedup_size": 1, "tags": ["<v>", "<w>", "<p>", "<v>", "<w>"], "variant": null, "speaker": {"id": "kalas", "status": "confirmed_data", "source": "auto", "candidates": [], "gender_evidence": {"verdict": "m", "m": 0.6, "f": 0}, "style": [], "script": {"status": "name_tag", "names": [{"id": "PCN_1", "en": "Kalas", "calls": 1}], "no_tag_calls": 0, "dynamic_calls": 0}, "name_tag": {"id": "PCN_1", "en": "Kalas"}, "basis": "табличка имени в скрипте игры (_SetNameTag)"}, "speaker_gender": "m", "addressee": {"id": "unknown", "status": "unknown", "candidates": []}, "addressee_gender": "unknown", "register": "unknown", "context": "", "ru": "<v>Хе-хе, представляю себе эту картину.<w><p><v>Ладно, найдём Святилище ветров и узнаем, что там происходит.<w>", "status": "edited", "qa_flags": [], "translator_note": "", "editor_note": "", "history": [{"ts": "2026-10-19T15:14:00", "actor": "translator/claude-sonnet-5.5", "action": "translator", "run": "runs/20261019/bk1_B0017_translator_151400.json"}, {"ts": "2026-10-19T15:14:03", "actor": "qa/local", "action": "qa_pass"}, {"ts": "2026-10-19T15:48:10", "actor": "editor/claude-sonnet-5.5", "action": "editor", "run": "runs/20261019/bk1_B0017_editor_154810.json"}]}
